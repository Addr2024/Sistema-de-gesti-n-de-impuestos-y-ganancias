# ===== .env.example (RAIZ - frontend React + Vite) =====
# Plantilla. Copia este archivo a .env y pon TUS valores reales.
# El archivo .env NO debe subirse al repositorio (ver .gitignore).
# Aqui solo van valores FICTICIOS de ejemplo.
#
# NOTA DE SEGURIDAD: el sitio no tiene backend, por lo que cualquier
# variable VITE_* queda incluida en el JavaScript compilado y es visible
# en el navegador. Sacar la clave del codigo evita exponerla en el repo,
# pero el login web sigue siendo una barrera de presentacion, NO seguridad
# real. Para seguridad real se requiere un backend (ver mejoras futuras).

VITE_ADMIN_EMAIL=correo@ejemplo.com
VITE_ADMIN_PASSWORD=cambia_esta_contraseña
