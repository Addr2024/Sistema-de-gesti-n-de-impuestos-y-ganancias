# ===== siga/.env.example (backend Python / MySQL) =====
# Plantilla. Copia este archivo a siga/.env y pon TUS valores reales.
# El archivo siga/.env NO debe subirse al repositorio (ver .gitignore).
# Las claves coinciden exactamente con las que lee config.py.
# Aqui solo van valores FICTICIOS de ejemplo.

# --- Credenciales de administrador de la aplicacion ---
ADMIN_EMAIL=correo@ejemplo.com
ADMIN_PASSWORD=cambia_esta_contrasena

# --- Conexion a la base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siga_db
DB_USER=root
DB_PASSWORD=cambia_esta_contrasena_de_bd
